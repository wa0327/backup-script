#!/bin/bash
# 從本機備份到 ext4。備份為本機的鏡像（帶 --delete）。

RSYNC_MODE=backup
source "$(dirname "$0")/common" || exit 1

J="$jammy_root/home/jack"        # jammy 家目錄（1env 時即本機家目錄）
JB="$BACKUP_ROOT/jammy/home/jack"
QB="$BACKUP_ROOT/questing/home/jack"

# ── jammy 的大目錄 ──────────────────────────────────────────────────
sync_dir "$J/miniconda3/envs" "$JB/miniconda3/envs" isaaclab

# Omniverse 快取（著色器／材質編譯結果，約 17G）。可重生，但重建耗時甚久，
# 備份是為了省下 Isaac Sim 首次啟動的編譯時間。
sync_dir "$J/.cache" "$JB/.cache" ov

# 飛控原始碼（各約 4G，含 build/ 與未提交的本機修改）
sync_files "$J" "$JB" ardupilot PX4-Autopilot

# 排除 .claude/memory：該路徑是 mount bind 掛載點，由下一行單獨備份，
# 若不排除，--delete 會依容器內的空掛載點刪光備份中的 memory
sync_dir "$J/repos" "$JB/repos" isaaclab-uav ".claude/memory"
sync_dir "$memory_live" "$memory_backup" memory

# ── 家目錄設定檔（清單與 1env 裁決表見 common）─────────────────────
sync_home_files to_backup

# 確保所有資料真正落到磁碟，避免拔碟時資料還停留在快取
sync
report 備份
