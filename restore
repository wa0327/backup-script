#!/bin/bash
# 從 ext4 還原回本機。只補不刪（--update 且不加 --delete），
# 本機較新或本機獨有的檔案一律保留，不會造成資料遺失。

RSYNC_MODE=restore
source "$(dirname "$0")/common" || exit 1

J="$jammy_root/home/jack"        # jammy 家目錄（1env 時即本機家目錄）
JB="$BACKUP_ROOT/jammy/home/jack"
QB="$BACKUP_ROOT/questing/home/jack"

# ── jammy 的大目錄 ──────────────────────────────────────────────────
sync_dir "$JB/miniconda3/envs" "$J/miniconda3/envs" isaaclab

# Omniverse 快取（約 17G），還原後可省去 Isaac Sim 首次啟動的重新編譯
sync_dir "$JB/.cache" "$J/.cache" ov

# 飛控原始碼
sync_files "$JB" "$J" ardupilot PX4-Autopilot

# 排除 .claude/memory：該路徑在 2env 上是 mount bind 掛載點，直接寫入會落在
# 容器 rootfs 的空掛載點而非真正的資料位置，故由下一行單獨還原到 bind 來源端
sync_dir "$JB/repos" "$J/repos" isaaclab-uav ".claude/memory"
sync_dir "$memory_backup" "$memory_live" memory

# ── 家目錄設定檔（清單與 1env 裁決表見 common）─────────────────────
sync_home_files to_home

report 還原
