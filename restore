#!/bin/bash

# sync_dir <源根目錄> <目標根目錄> <子目錄> [排除路徑...]
# 排除路徑為相對於 <子目錄> 的 rsync --exclude 樣式，用於保護由其他行負責的子路徑
# 例：sync_dir /media/jack/ext4/jammy/home/jack/miniconda3/envs /home/jack/miniconda3/envs isaaclab
sync_dir() {
    local src_root="$1"
    local dst_root="$2"
    local sub="$3"
    shift 3

    local excludes=()
    local e
    for e in "$@"; do
        excludes+=(--exclude "$e")
    done

    if [ ! -e "$src_root/$sub" ]; then
        echo "[$sub] 來源不存在，略過"
        return
    fi

    if [ ! -e "$dst_root/$sub" ]; then
        # 目標不存在：第一次，全量搬遷
        echo "[$sub] 目標不存在，執行全量搬遷"
        mkdir -p "$dst_root"
        local tar_excludes=()
        for e in "$@"; do
            tar_excludes+=(--exclude "$sub/$e")
        done
        # PIPESTATUS 檢查打包端，管線末端的解壓成功不代表來源全部讀得到
        tar -cf - "${tar_excludes[@]}" -C "$src_root" "$sub" | tar -xpf - -C "$dst_root"
        local rc=("${PIPESTATUS[@]}")
        if [ "${rc[0]}" != 0 ] || [ "${rc[1]}" != 0 ]; then
            echo "[$sub] !! 全量搬遷失敗（tar 打包=${rc[0]} 解壓=${rc[1]}）"
            failed+=("$sub")
        fi
    else
        echo "[$sub] 目標已存在，執行增量同步"
        # 還原方向刻意不加 --delete：本機多出來的檔案一律保留，不因備份端沒有而刪除。
        # --update：目標端較新者不覆蓋，避免蓋掉本機尚未備份的工作。
        # 兩者合起來使還原為「只補不刪、只更新較舊者」，不會造成本機資料遺失。
        if ! rsync -aHAX --numeric-ids --update "${excludes[@]}" "$src_root/$sub" "$dst_root/"; then
            echo "[$sub] !! 增量同步失敗"
            failed+=("$sub")
        fi
    fi
}

# 記錄失敗項目，結尾統一回報
failed=()

# 本機若有 lxc jammy 容器：本機身分是 questing host，容器身分是 jammy
# 本機若沒有 lxc jammy 容器：本機自己就當作 jammy
if [ -d /var/lib/lxc/jammy/rootfs ]; then
    has_container=1
    jammy_root=/var/lib/lxc/jammy/rootfs
else
    has_container=0
    jammy_root=""
fi

# 備份的反向：從 ext4 還原回原路徑
sync_dir /media/jack/ext4/jammy/home/jack/miniconda3/envs "$jammy_root/home/jack/miniconda3/envs" isaaclab

# Omniverse 快取（約 17G），還原後可省去 Isaac Sim 首次啟動的重新編譯
sync_dir /media/jack/ext4/jammy/home/jack/.cache "$jammy_root/home/jack/.cache" ov

# 飛控原始碼
for d in ardupilot PX4-Autopilot; do
    sync_dir /media/jack/ext4/jammy/home/jack "$jammy_root/home/jack" "$d"
done

# 排除 .claude/memory：該路徑在 questing host 上是 mount bind 掛載點，
# 直接寫入會落在容器 rootfs 的空掛載點而非真正的資料位置，故由下一段單獨還原到 bind 來源端
sync_dir /media/jack/ext4/jammy/home/jack/repos "$jammy_root/home/jack/repos" isaaclab-uav \
         ".claude/memory"

# Claude memory：還原回 bind 來源端（questing host）或原處（純 jammy）
if [ "$has_container" = 1 ]; then
    memory_dst=/home/jack/.claude/projects/-home-jack-repos-isaaclab-uav
else
    memory_dst="$jammy_root/home/jack/repos/isaaclab-uav/.claude"
fi
sync_dir /media/jack/ext4/jammy/home/jack/repos/isaaclab-uav/.claude "$memory_dst" memory

# 基本設定檔清單（需與 backup 保持一致）
dotfiles=(
    .ssh .gnupg
    .bashrc .profile .bash_aliases .inputrc .selected_editor
    .gitconfig .git-credentials
    .condarc
    .claude.json
    .bash_history .python_history
    .colcon
)

vscode_user=(settings.json keybindings.json snippets)

restore_home() {
    local src_root="$1"   # 對應的備份目錄
    local dst_root="$2"   # 該身分的家目錄

    local f
    for f in "${dotfiles[@]}"; do
        sync_dir "$src_root" "$dst_root" "$f"
    done

    for f in "${vscode_user[@]}"; do
        sync_dir "$src_root/.config/Code/User" "$dst_root/.config/Code/User" "$f"
    done
}

# 還原 jammy（容器或裸機本身）
restore_home /media/jack/ext4/jammy/home/jack "$jammy_root/home/jack"

# 有 lxc 容器時，本機是 questing host，額外還原 questing 自己（裸機 /home/jack）
if [ "$has_container" = 1 ]; then
    restore_home /media/jack/ext4/questing/home/jack /home/jack
    for f in set_governor.sh isaaclab.json; do
        sync_dir /media/jack/ext4/questing/home/jack /home/jack "$f"
    done
fi

if [ ${#failed[@]} -gt 0 ]; then
    echo "!! 還原未完全成功，以下項目失敗：${failed[*]}"
    exit 1
fi
echo "還原完成"
